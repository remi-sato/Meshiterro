<div>
 <%= image_tag @post_image.get_image %>
 
 <p>ショップ名:<%= @post_image.shop_name %></p>
 <p class="card-title">
  <%= link_to(post_image_path(@post_image.id),class:"text-dark") do %>
   <strong><i class="fa-solid fa-flag"></i><span><%= @post_image.shop_name %></span></strong>
  <% end %> 
 </p>
 <p class="card-title">
  <span><i class="fa-solid fa-location-dot"></i><%= @post_image.address %></span>
 </p>
 <p class="card-title">説明:<%= @post_image.caption %></p>
 <p>投稿ユーザー画像:<%= image_tag @post_image.user.get_profile_image(100,100)  %></p>
 <p>ユーザーネーム:<%= @post_image.user.name %></p>
 <p>投稿日時:<%= @post_image.created_at.strftime('%Y/%m/%d') %></p>
  <% if @post_image.user == Current.user %>
    <%= link_to "削除", post_image_path(@post_image), data: { turbo_method: :delete } %>
  <% end %>
  <% if @post_image.favorited_by?(Current.user) %>
   <p>
    <%= link_to post_image_favorite_path(@post_image),data: {turbo_method: :delete} do %>
      ♥<%= @post_image.favorites.count %>いいね
    <% end %>
   </p>
  <% else %> 
   <p>
    <%= link_to post_image_favorite_path(@post_image),data: {turbo_method: "post"} do %>
      ♡<%= @post_image.favorites.count %>いいね
    <% end %>
   </p>
  <% end %>   
</div>

<div>
  <p>コメント件数:<%= @post_image.post_comments.count %></p>
  <% @post_image.post_comments.each do |post_comment| %>
   <p><%=image_tag post_comment.user.get_profile_image(100,100) %></p>
   <%= post_comment.user.name %>
   <%= post_comment.created_at.strftime('%Y/%m/%d') %><%= post_comment.comment %>
  <% end %>
 </div> 

 <div>
  <%=form_with model:[@post_image,@post_comment] do |f| %>
    <%= f.text_area :comment,rows: "5" ,placeholder: "コメントをここに" %>
    <%= f.submit "送信する" %>
  <% end %>  
</div>